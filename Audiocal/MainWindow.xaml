<Window x:Class="Audiocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Audiocal"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1110"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F3"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171E1B"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202925"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="#1B2320"/>
        <SolidColorBrush x:Key="SongListBrush" Color="#141A18"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#43D9A3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A19A"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#26312C"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#35423B"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#304039"/>
        <SolidColorBrush x:Key="AudioSpectrumBrush" Color="#43D9A3"/>
        <SolidColorBrush x:Key="AudioSpectrumRedBrush" Color="#FF0000"/>
        <SolidColorBrush x:Key="AudioSpectrumBlueBrush" Color="#0000FF"/>
        <SolidColorBrush x:Key="AudioSpectrumIconBrush" Color="#43D9A3"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SearchBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddLibraryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#07130E"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="MiniPlayerPinButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PinButtonBackground"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="True">
                                <Setter TargetName="PinButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlayPauseIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="PlayPauseGlyph"
                      Data="M4,3 H7 V15 H4 Z M11,3 H14 V15 H11 Z"
                      Fill="#07130E"
                      Stretch="Uniform"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="▶">
                    <Setter TargetName="PlayPauseGlyph"
                            Property="Data"
                            Value="M5,3 L15,9 L5,15 Z"/>
                    <Setter TargetName="PlayPauseGlyph" Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="2"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LoopIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="LoopGlyph"
                      Data="M4,8 C4,5 6,3 9,3 C11,3 13,5 13,7 M13,7 L10,5 M13,7 L15,5 M14,10 C14,13 12,15 9,15 C7,15 5,13 5,11 M5,11 L8,13 M5,11 L3,13"
                      Stroke="{DynamicResource TextMutedBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"/>
                <TextBlock x:Name="LoopOneBadge"
                           Text="1"
                           FontSize="8"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Background="{DynamicResource PanelBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="🔁">
                    <Setter TargetName="LoopGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="🔂">
                    <Setter TargetName="LoopGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="LoopOneBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ShuffleIconTemplate">
            <Grid Width="20" Height="20">
                <Path x:Name="ShuffleGlyph"
                      Data="M3,6 H5 C9,6 11,14 15,14 H18 M15,11 L18,14 L15,17 M3,14 H5 C6.5,14 7.5,12 8.5,10 M13,6 H15 C16,6 17,7 18,8 M15,3 L18,6 L15,9"
                      Stroke="{DynamicResource TextMutedBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="🔀">
                    <Setter TargetName="ShuffleGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MuteIconTemplate">
            <Grid Width="19" Height="19">
                <Path x:Name="VolumeGlyph"
                      Data="M3,8 H6 L11,4 V16 L6,12 H3 Z M14,7 C16,9 16,11 14,13 M16,5 C19,8 19,12 16,15"
                      Stroke="#E9F1ED"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="🔇">
                    <Setter TargetName="VolumeGlyph"
                            Property="Data"
                            Value="M3,8 H6 L11,4 V16 L6,12 H3 Z M14,8 L18,12 M18,8 L14,12"/>
                    <Setter TargetName="VolumeGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PlayButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="ContentTemplate" Value="{StaticResource PlayPauseIconTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="26"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoopButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource LoopIconTemplate}"/>
        </Style>

        <Style x:Key="ShuffleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource ShuffleIconTemplate}"/>
        </Style>

        <Style x:Key="MuteButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ContentTemplate" Value="{StaticResource MuteIconTemplate}"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="1"
                                               Text="›"
                                               FontSize="17"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="14,0,0,0"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="5"
                                        MinWidth="190">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseDoubleClick"
                         Handler="SongListItem_MouseDoubleClick"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="SongListItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              IsTabStop="False"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#405148"
                                                    CornerRadius="4"
                                                    Margin="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              IsTabStop="False"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid MinHeight="42">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False"
                                                  Focusable="False"
                                                  Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Grid Height="42"
                                                      Background="Transparent">
                                                    <Border Height="4"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="SliderThumb"
                                                        Background="{DynamicResource AccentBrush}"
                                                        BorderBrush="{DynamicResource WindowBackgroundBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="7"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SliderThumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False"
                                                  Focusable="False"
                                                  Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Grid Height="42"
                                                      Background="Transparent">
                                                    <Border Height="4"
                                                            Background="#344139"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                                <Border x:Name="SliderPreviewSegment"
                                        Height="4"
                                        Width="0"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayoutGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopBarBorder"
                Grid.Row="0"
                Background="{DynamicResource TopBarBrush}"
                CornerRadius="16"
                Padding="20,16"
                Height="110"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="13"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="A"
                                   Foreground="#07130E"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AUDIOCAL"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock Text="YOUR MUSIC, YOUR WAY"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Menu Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Margin="24,0,0,0">
                    <MenuItem Header="Settings"
                              FontWeight="SemiBold">
                        <MenuItem Header="Colour Theme"
                                  Click="SettingsMenuItem_Click"/>
                        <MenuItem Header="Audio Spectrum"
                                  Click="AudioSpectrumSettingsMenuItem_Click"/>
                        <MenuItem Header="Storage paths"
                                  Click="RootFolderMenuItem_Click"/>
                        <MenuItem Header="Import URL"
                                  Click="ImportPlaylistMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="Library"
                              x:Name="LibraryMenuItem"
                              FontWeight="SemiBold"/>
                </Menu>

                <Grid Grid.Column="2" Height="78" VerticalAlignment="Center" Margin="18,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.RowSpan="2"
                                Orientation="Horizontal"
                                Height="38"
                                VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="266"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YouTubeUrlTextBox"
                                     Grid.Column="0"
                                     Height="38"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Search for a song"
                                     TextChanged="YouTubeUrlTextBox_TextChanged"
                                     GotKeyboardFocus="YouTubeUrlTextBox_GotKeyboardFocus"
                                     KeyDown="YouTubeUrlTextBox_KeyDown"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <ProgressBar x:Name="PlaylistDownloadProgressBar"
                                     Height="4"
                                     Margin="4,0,0,2"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="DownloadStatusText"
                                   Text="Song downloaded"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Popup x:Name="YouTubeSearchPopup"
                       PlacementTarget="{Binding ElementName=YouTubeUrlTextBox}"
                       Placement="Bottom"
                       HorizontalOffset="-210"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border x:Name="YouTubeSearchPopupContent"
                            Width="440"
                            MaxHeight="520"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8">
                        <StackPanel>
                            <StackPanel x:Name="YouTubeSearchLoadingPanel"
                                       Visibility="Collapsed"
                                       Margin="8,8,8,12">
                               <TextBlock Text="Searching YouTube..."
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          FontSize="12"
                                          Margin="0,0,0,8"/>
                               <ProgressBar Height="3"
                                            IsIndeterminate="True"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            BorderThickness="0"/>
                            </StackPanel>
                            <ScrollViewer x:Name="YouTubeSearchScrollViewer"
                                          MaxHeight="450"
                                          VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled">
                               <ItemsControl x:Name="YouTubeSearchResults">
                                   <ItemsControl.ItemTemplate>
                                       <DataTemplate>
                                           <Grid MinHeight="68">
                                               <Grid.ColumnDefinitions>
                                                   <ColumnDefinition Width="112"/>
                                                   <ColumnDefinition Width="*"/>
                                                   <ColumnDefinition Width="48"/>
                                               </Grid.ColumnDefinitions>
                                               <Button Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Tag="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Padding="8"
                                                       HorizontalContentAlignment="Stretch"
                                                       ToolTip="Double-click to preview"
                                                       MouseDoubleClick="YouTubeSearchResult_PreviewDoubleClick">
                                                   <Grid MinHeight="68">
                                                       <Grid.ColumnDefinitions>
                                                           <ColumnDefinition Width="112"/>
                                                           <ColumnDefinition Width="*"/>
                                                       </Grid.ColumnDefinitions>
                                                       <Border Width="104"
                                                               Height="58"
                                                               CornerRadius="6"
                                                               Background="{DynamicResource ControlBackgroundBrush}"
                                                               ClipToBounds="True"
                                                               VerticalAlignment="Center">
                                                           <Image Source="{Binding ThumbnailUrl}"
                                                                  Stretch="UniformToFill"/>
                                                       </Border>
                                                       <StackPanel Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,2,0">
                                                           <TextBlock Text="{Binding Title}"
                                                                      FontSize="12"
                                                                      FontWeight="SemiBold"
                                                                      TextWrapping="Wrap"
                                                                      MaxHeight="36"
                                                                      TextTrimming="CharacterEllipsis"/>
                                                           <TextBlock Text="{Binding Channel}"
                                                                      FontSize="10"
                                                                      Foreground="{DynamicResource TextMutedBrush}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      Margin="0,4,0,0"/>
                                                       </StackPanel>
                                                   </Grid>
                                               </Button>
                                               <Button Grid.Column="2"
                                                       Tag="{Binding}"
                                                       Width="48"
                                                       Height="48"
                                                       Style="{StaticResource AddLibraryButtonStyle}"
                                                       Padding="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       ToolTip="Add to library"
                                                       Click="YouTubeSearchResult_AddClick">
                                                   <Path Data="M10,2 V18 M2,10 H18"
                                                         Width="18"
                                                         Height="18"
                                                         Stretch="Uniform"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2"
                                                         StrokeStartLineCap="Round"
                                                         StrokeEndLineCap="Round"/>
                                               </Button>
                                           </Grid>
                                       </DataTemplate>
                                   </ItemsControl.ItemTemplate>
                               </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>
        </Border>

        <Border x:Name="LibraryBorder"
                Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                CornerRadius="16"
                Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="YOUR LIBRARY"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="CurrentLibraryNameText"
                               Text=""
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="8,0,8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="TITLE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2"
                               Text="ARTIST"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>

                <ListBox x:Name="SongList"
                         Grid.Row="2"
                         Background="{DynamicResource SongListBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="10"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Path Data="M14,5 V14.5 A2.5,2.5 0 1 1 12,12 V7 L19,5 V12.5 A2.5,2.5 0 1 1 17,10 V3.5 Z"
                                          Width="17"
                                          Height="17"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource AccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Artist}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="PlayerBorder"
                Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                CornerRadius="16"
                Padding="22,10"
                Margin="0,12,0,0"
                PreviewMouseLeftButtonDown="PlayerBorder_PreviewMouseLeftButtonDown">
            <Grid x:Name="PlayerContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="AudioSpectrumCanvas"
                        Grid.Row="2"
                        Panel.ZIndex="0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Ellipse x:Name="AudioSpectrumRedCopy"
                             Width="100"
                             Height="100"
                             Fill="{DynamicResource AudioSpectrumRedBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="AudioSpectrumBlueCopy"
                             Width="100"
                             Height="100"
                             Fill="{DynamicResource AudioSpectrumBlueBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="AudioSpectrumCircle"
                             Width="100"
                             Height="100"
                             Fill="{DynamicResource AudioSpectrumBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NowPlayingPanel">
                        <TextBlock x:Name="NowPlayingLabel"
                                   Text="CURRENT SONG"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="NowPlayingText"
                                   Text="No song selected"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="VolumeControlsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MuteButton"
                                Content="🔊"
                                Style="{StaticResource MuteButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Toggle mute"
                                Click="MuteButton_Click"/>
                        <Slider x:Name="VolumeSlider"
                                Width="100"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="VolumeSlider_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                MouseLeave="VolumeSlider_MouseLeave"/>
                        <TextBlock x:Name="VolumeText"
                                   Text="100%"
                                   Width="42"
                                   TextAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="MiniPlayerPinButton"
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Style="{StaticResource MiniPlayerPinButtonStyle}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Tag="False"
                            Visibility="Collapsed"
                            ToolTip="Keep miniplayer on top"
                            Click="MiniPlayerPinButton_Click">
                        <Path Data="M7,2 H17 L16,7 L19,10 V12 H13 V20 L12,22 L11,20 V12 H5 V10 L8,7 Z"
                              Width="11"
                              Height="14"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}">
                                    <Setter Property="Fill"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           Value="True"/>
                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="#C6D5CF"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </Grid>

                <Grid x:Name="PlaybackProgressGrid"
                     Grid.Row="1"
                     Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText"
                               Text="00:00"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Height="42"
                            VerticalAlignment="Center"
                            PreviewMouseMove="ProgressSlider_PreviewMouseMove"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            MouseLeave="ProgressSlider_MouseLeave"/>
                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Text="00:00"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Button x:Name="MiniPlayerToggleButton"
                            Style="{StaticResource TransportButtonStyle}"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Left"
                            ToolTip="Switch to miniplayer"
                            Click="MiniPlayerToggleButton_Click">
                        <Path Data="M3,4 H17 V15 H3 Z M7,18 H13"
                              Width="17"
                              Height="17"
                              Stretch="Uniform"
                              Stroke="#E9F1ED"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="AudioSpectrumToggleButton"
                            Style="{StaticResource TransportButtonStyle}"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            ToolTip="Toggle audio spectrum"
                            Click="AudioSpectrumToggleButton_Click">
                        <Path Data="M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M10,5 A5,5 0 1 1 10,15 A5,5 0 1 1 10,5"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Fill="{DynamicResource AudioSpectrumIconBrush}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                    <Button x:Name="LoopButton"
                            Content="↻"
                            Style="{StaticResource LoopButtonStyle}"
                            ToolTip="Loop"
                            Click="LoopButton_Click"/>
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource TransportButtonStyle}"
                            ToolTip="Previous song"
                            Click="PreviousButton_Click">
                        <Path Data="M5,4 V16 M17,4 L8,10 L17,16 Z"
                              Width="17"
                              Height="17"
                              Stretch="Uniform"
                              Stroke="#E9F1ED"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Fill="#E9F1ED"/>
                    </Button>
                    <Button x:Name="PlayPauseButton"
                            Content="▶"
                            Style="{StaticResource PlayButtonStyle}"
                            Margin="7,0"
                            ToolTip="Play or pause"
                            Click="PlayPauseButton_Click"/>
                    <Button x:Name="NextButton"
                            Style="{StaticResource TransportButtonStyle}"
                            ToolTip="Next song"
                            Click="NextButton_Click">
                        <Path Data="M15,4 V16 M3,4 L12,10 L3,16 Z"
                              Width="17"
                              Height="17"
                              Stretch="Uniform"
                              Stroke="#E9F1ED"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Fill="#E9F1ED"/>
                    </Button>
                    <Button x:Name="ShuffleButton"
                            Content="↕"
                            Style="{StaticResource ShuffleButtonStyle}"
                            ToolTip="Shuffle playback order"
                            Click="ShuffleButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Grid x:Name="LibraryDialogOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="#B30D1110"
              PreviewKeyDown="LibraryDialogOverlay_PreviewKeyDown">
            <Border Width="430"
                    Padding="28"
                    CornerRadius="24"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LibraryDialogTitle"
                               Text="Create library"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="LibraryDialogInstruction"
                               Text="Folder name"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,6,0,16"/>
                    <TextBox x:Name="LibraryNameTextBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Height="44"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="LibraryNameTextBox_PreviewKeyDown"/>
                    <TextBlock x:Name="LibraryDialogErrorText"
                               Foreground="#FF8A80"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="4,8,4,0"
                               Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button Content="Cancel"
                                Style="{StaticResource LibraryDialogButtonStyle}"
                                MinWidth="96"
                                Margin="0,0,10,0"
                                Click="LibraryDialogCancelButton_Click"/>
                        <Button x:Name="LibraryDialogActionButton"
                                Content="Create"
                                Style="{StaticResource LibraryDialogButtonStyle}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="#07130E"
                                BorderBrush="{DynamicResource AccentBrush}"
                                MinWidth="96"
                                Click="LibraryDialogActionButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
