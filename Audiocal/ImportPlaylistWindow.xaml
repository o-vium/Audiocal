<Window x:Class="Audiocal.ImportPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import URL"
        Width="420"
        Height="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171E1B"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202925"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#43D9A3"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A19A"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#35423B"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource PanelBrush}"
            CornerRadius="16"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Import URL" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Paste a YouTube song or playlist URL to add it to the selected library."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent">
                                <Path x:Name="CloseGlyph"
                                      Data="M5,5 L19,19 M19,5 L5,19"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseGlyph"
                                            Property="Stroke"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <TextBox x:Name="UrlTextBox"
                     Grid.Row="1"
                     Margin="0,18,0,0"
                     Height="38"
                     VerticalContentAlignment="Center"
                     ToolTip="Paste a YouTube song or playlist URL"
                     PreviewKeyDown="UrlTextBox_PreviewKeyDown"/>
            <TextBlock x:Name="ErrorText"
                       Grid.Row="2"
                       Foreground="#FF8A80"
                       FontSize="11"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Click="CloseButton_Click"/>
                <Button Content="Import"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="#07130E"
                        Click="ImportButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
