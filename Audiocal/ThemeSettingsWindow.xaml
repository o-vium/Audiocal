<Window x:Class="Audiocal.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audiocal settings"
        Width="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        MinWidth="340"
        MaxWidth="340"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171E1B"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202925"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#43D9A3"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A19A"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#35423B"/>
        <SolidColorBrush x:Key="AudioSpectrumBrush" Color="#43D9A3"/>
        <SolidColorBrush x:Key="AudioSpectrumRedBrush" Color="#FF0000"/>
        <SolidColorBrush x:Key="AudioSpectrumBlueBrush" Color="#0000FF"/>
        <SolidColorBrush x:Key="AudioSpectrumIconBrush" Color="#43D9A3"/>
        <DataTemplate x:Key="ColorOptionTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,5,0"
                           MouseEnter="ColorName_MouseEnter"
                           MouseLeave="ColorName_MouseLeave"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="9"
                         CharacterCasing="Upper"
                         Tag="{Binding Key}"/>
                <ToggleButton x:Name="ColorButton"
                              Grid.Column="2"
                              Width="20"
                              Height="22"
                              Margin="0"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="Adjust RGB values">
                    <Border Width="16"
                            Height="16"
                            CornerRadius="8"
                            Background="{Binding PreviewBrush}"
                            BorderBrush="#F1F5F3"
                            BorderThickness="2"/>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=ColorButton}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=ColorButton, Mode=TwoWay}"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Width="250">
                        <StackPanel>
                            <TextBlock Text="RGB color"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" Foreground="#FF7777"/>
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="255"
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Red}"
                                           HorizontalAlignment="Right"
                                           FontSize="10"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="G" Foreground="#77DD88"/>
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="255"
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Green}"
                                           HorizontalAlignment="Right"
                                           FontSize="10"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" Foreground="#7799FF"/>
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="255"
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Blue}"
                                           HorizontalAlignment="Right"
                                           FontSize="10"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpacity}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="A" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="255"
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Alpha}"
                                           HorizontalAlignment="Right"
                                           FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="{DynamicResource PanelBrush}"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7,7,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource PanelBrush}"
            CornerRadius="16"
            Padding="16"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Customize the application colors"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="Transparent">
                                    <Path x:Name="CloseGlyph"
                                          Data="M5,5 L19,19 M19,5 L5,19"
                                          Width="18"
                                          Height="18"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseGlyph"
                                                Property="Stroke"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
            </Grid>
            <TabControl x:Name="PaletteTabControl"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        SelectionChanged="PaletteTabControl_SelectionChanged">
                <TabItem Header="Standard">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StandardColors}"
                                      ItemTemplate="{StaticResource ColorOptionTemplate}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="MiniPlayer">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MiniPlayerColors}"
                                      ItemTemplate="{StaticResource ColorOptionTemplate}"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
